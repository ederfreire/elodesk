# ============================================
# API Oficial - Variáveis de Ambiente
# ============================================

# ── Banco de Dados (PostgreSQL) ──────────────
POSTGRES_USER=waticket
POSTGRES_PASSWORD=senha_segura
DATABASE_LINK=postgresql://waticket:senha_segura@localhost:5432/api_oficial?schema=public

# ── Admin Padrão ────────────────────────────
NAME_ADMIN=Admin
EMAIL_ADMIN=admin@seudominio.com.br
PASSWORD_ADMIN=senha_admin_segura
TOKEN_ADMIN=token_admin_seguro

# ── Autenticação ────────────────────────────
JWT_SECRET=chave_jwt_api_oficial

# ── RabbitMQ ────────────────────────────────
RABBITMQ_URL=amqp://rabbitmq:senha_segura@localhost/rabbitmq
RABBITMQ_ENABLED_GLOBAL=false

# ── Redis ───────────────────────────────────
REDIS_URI=redis://:123456@127.0.0.1:6379

# ── Integrações ─────────────────────────────
URL_BACKEND_MULT100=

# ── Meta / WhatsApp Business ────────────────
# App ID do Meta (Facebook for Developers). Obrigatório para criar templates
# com cabeçalho do tipo IMAGE/VIDEO/DOCUMENT (Resumable Upload API).
META_APP_ID=

# ── Servidor ────────────────────────────────
PORT=6000
