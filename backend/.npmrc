# Configuração otimizada para baixo consumo de memória e disco
fund=false
audit=false
progress=false
loglevel=error
prefer-offline=true
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
# Menos conexões simultâneas = menos uso de RAM
maxsockets=3
# Não salvar package-lock extra desnecessariamente
save-exact=false
legacy-peer-deps=true
