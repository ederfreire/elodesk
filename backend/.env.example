# ============================================
# Backend - Variáveis de Ambiente
# ============================================

# ── URLs ──────────────────────────────────────
BACKEND_URL=https://api.seudominio.com.br
FRONTEND_URL=https://app.seudominio.com.br

# ── Porta do Servidor ────────────────────────
PORT=8080
PROXY_PORT=

# ── Banco de Dados (PostgreSQL) ──────────────
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=waticket
DB_USER=waticket
DB_PASS=senha_segura
DB_POOL_MAX=100
DB_POOL_MIN=15
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=600000

# ── Redis ────────────────────────────────────
REDIS_URI=redis://:123456@127.0.0.1:6379
REDIS_URI_ACK=
REDIS_SECRET_KEY=
REDIS_OPT_LIMITER_MAX=1
REDIS_OPT_LIMITER_DURATION=3000

# ── Autenticação / JWT ───────────────────────
JWT_SECRET=sua_chave_jwt_secreta_aqui
JWT_REFRESH_SECRET=sua_chave_refresh_secreta_aqui
MASTER_KEY=

# ── Tokens de Segurança ─────────────────────
ENV_TOKEN=
COMPANY_TOKEN=
VERIFY_TOKEN=whaticket


# ── SMTP / E-mail ───────────────────────────
MAIL_HOST=smtp.seudominio.com.br
MAIL_USER=noreply@seudominio.com.br
MAIL_PASS=senha_email
MAIL_FROM=noreply@seudominio.com.br
SMTP_HOST=smtp.seudominio.com.br
SMTP_PORT=587
SMTP_USER=noreply@seudominio.com.br
SMTP_PASS=senha_email
SMTP_FROM=noreply@seudominio.com.br

# ── Meta / Facebook + Instagram (Embedded Signup via Facebook Login) ────────
# Mesmo App ID/Secret é usado para WhatsApp Cloud API, Facebook Messenger e Instagram DMs.
# Cliente conecta via popup OAuth → token salvo em Whatsapps(facebookUserToken) por empresa.
FACEBOOK_APP_ID=2021770751787040
FACEBOOK_APP_SECRET=e53b6bd5cb1658037f43cb927ad1acc3


# ── API Oficial WhatsApp ─────────────────────
USE_WHATSAPP_OFICIAL=false
URL_API_OFICIAL=http://localhost:6000
TOKEN_API_OFICIAL=

# ── Transcrição de Áudio ────────────────────
TRANSCRIBE_URL=http://localhost:4002
TRANSCRIBE_API_KEY=

# ── WaCalls (mensagem via wacalls-voip) ─────
WACALLS_URL=http://127.0.0.1:8090
WACALLS_SHARED_SECRET=

# ── WaCalls-Chat (chamada de voz real) ──────
# Instância própria do github.com/raphaelbat/wacalls-chat rodando no seu
# servidor. Usada só pra sinalização/áudio de chamada — mensagem continua
# no WACALLS_URL acima. Precisa de uma conta de serviço dedicada (criada no
# próprio wacalls-chat) que o backend usa pra logar e manter o cookie de
# sessão — não exponha essa senha em lugar nenhum além daqui.
WACALLS_CHAT_URL=http://127.0.0.1:8081
WACALLS_CHAT_EMAIL=
WACALLS_CHAT_PASSWORD=

# ── Push Notifications (VAPID) ──────────────
# Gere as chaves com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@seudominio.com.br

# ── Stripe (Pagamentos) ─────────────────────
STRIPE_OK_URL=https://app.seudominio.com.br/financeiro
STRIPE_CANCEL_URL=https://app.seudominio.com.br/financeiro

# ── Gerencianet ─────────────────────────────
GERENCIANET_CLIENT_ID=
GERENCIANET_CLIENT_SECRET=
GERENCIANET_SANDBOX=false

# ── MercadoPago ─────────────────────────────
MP_NOTIFICATION_URL=

# ── Bull Board (Fila de Jobs) ───────────────
BULL_BOARD=false
BULL_USER=admin
BULL_PASS=senha_bull

# ── Socket Admin ────────────────────────────
SOCKET_ADMIN=true

# ── Sentry (Monitoramento) ──────────────────
SENTRY_DSN=


# ── Deploy ──────────────────────────────────
DEPLOY_PASSWORD=

# ── Outros ──────────────────────────────────
DEMO=OFF
TIMEOUT_TO_IMPORT_MESSAGE=330
NODE_ENV=production
